<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>PathFinder.CalculationKernel</AssemblyName>
    <RootNamespace>PathFinder</RootNamespace>
    <PackageId>PathFinder.CalculationKernel</PackageId>
    <Description>The public astronomical and astrological calculation kernel used by PathFinder's reproducible benchmark.</Description>
    <PackageTags>astronomy;astrology;ephemeris;reproducibility</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CosineKitty.AstronomyEngine" />
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../LICENSES/*" Pack="true" PackagePath="LICENSES/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PathFinder.CalculationKernel.Tests" />
    <InternalsVisibleTo Include="PathFinder.AccuracyBenchmark.Tests" />
  </ItemGroup>

</Project>
