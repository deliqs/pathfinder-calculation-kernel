{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deliqs/pathfinder-calculation-kernel/benchmark/schemas/cases.schema.json",
  "title": "PathFinder calculation benchmark cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasetRevision", "positions", "houses", "timings", "historicalTimes"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "datasetRevision": { "type": "string", "minLength": 1 },
    "positions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bodies", "epochs"],
      "properties": {
        "bodies": { "type": "array", "items": { "$ref": "#/$defs/positionBody" }, "minItems": 1 },
        "epochs": { "type": "array", "items": { "$ref": "#/$defs/positionEpoch" }, "minItems": 1 }
      }
    },
    "houses": { "type": "array", "items": { "$ref": "#/$defs/houseCase" } },
    "timings": { "type": "array", "items": { "$ref": "#/$defs/timingCase" } },
    "historicalTimes": { "type": "array", "items": { "$ref": "#/$defs/historicalCase" } }
  },
  "$defs": {
    "positionBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body", "horizonsCommand", "horizonsTargetId", "horizonsTargetHeader", "toleranceArcsec"],
      "properties": {
        "body": { "type": "string" },
        "horizonsCommand": { "type": "string" },
        "horizonsTargetId": { "type": "string" },
        "horizonsTargetHeader": { "type": "string" },
        "toleranceArcsec": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "positionEpoch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "utc", "horizonsUt"],
      "properties": {
        "id": { "type": "string" },
        "utc": { "type": "string", "format": "date-time" },
        "horizonsUt": { "type": "string" }
      }
    },
    "houseCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "utc", "latitude", "eastPositiveLongitude", "requestedSystem", "referenceSystem", "swissHouseSystemCode", "toleranceArcsec"],
      "properties": {
        "id": { "type": "string" },
        "utc": { "type": "string", "format": "date-time" },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "eastPositiveLongitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "requestedSystem": { "enum": ["Placidus", "Koch", "Regiomontanus", "Campanus"] },
        "referenceSystem": { "enum": ["Placidus", "Koch", "Regiomontanus", "Campanus", "Porphyry"] },
        "swissHouseSystemCode": { "enum": ["P", "K", "R", "C", "O"] },
        "toleranceArcsec": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "timingCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "body", "motion", "targetLongitudeDeg", "extremum", "searchStartUtc", "searchWindowDays", "method", "toleranceMinutes"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["longitude-crossing", "station"] },
        "body": { "type": "string" },
        "motion": { "enum": ["direct", "retrograde"] },
        "targetLongitudeDeg": { "type": ["number", "null"], "minimum": 0, "exclusiveMaximum": 360 },
        "extremum": { "type": ["string", "null"], "enum": ["minimum", "maximum", null] },
        "searchStartUtc": { "type": "string", "format": "date-time" },
        "searchWindowDays": { "type": "integer", "minimum": 1 },
        "method": { "type": "string" },
        "toleranceMinutes": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "historicalCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requestedLocal", "zoneId", "resolutionMethod", "compatibilityCase"],
      "properties": {
        "id": { "type": "string" },
        "requestedLocal": { "type": "string" },
        "zoneId": { "type": "string" },
        "resolutionMethod": { "const": "nodatime-in-zone-leniently" },
        "compatibilityCase": { "const": true }
      }
    }
  }
}
