<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="local-packages" value="./artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </auditSources>
  <packageSourceMapping>
    <packageSource key="local-packages">
      <package pattern="PathFinder.CalculationKernel" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="CosineKitty.*" />
      <package pattern="Microsoft.*" />
      <package pattern="NodaTime" />
      <package pattern="xunit*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
